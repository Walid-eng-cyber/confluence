# Copy to .env and adjust if your Ollama setup differs from the defaults.

OLLAMA_BASE_URL=http://localhost:11434

# Fast model for interactive Setup Review
OLLAMA_CHAT_MODEL=deepseek-r1:8b

# Heavier model for Reports / Strategy Advisor (slower, better reasoning)
OLLAMA_ADVISOR_MODEL=qwen2.5:14b-instruct

# Embedding model (multilingual — handles the German/English mix in the strategy notes)
OLLAMA_EMBED_MODEL=bge-m3

CHROMA_PERSIST_DIR=./data/vector_store
TRADE_DB_PATH=./data/trades/confluence.db